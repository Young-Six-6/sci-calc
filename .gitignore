# Operating-system metadata
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini
**/Desktop.ini

# PlatformIO and other local embedded build state
**/.pio/
**/.pioenvs/
**/.sconsign*.dblite

# Python caches and test-tool state
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/

# Node/Electron dependencies and generated application bundles
**/node_modules/
**/dist/
**/out/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor metadata (tracked project settings remain visible)
.idea/
**/.idea/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/

# Logs, temporary files, and editor swap files
*.log
*.tmp
*.temp
*.swp
*.swo

# Published firmware images in sci_calc_code/bin, games/*/firmware.bin,
# and existing games/*/build trees are intentionally not ignored.
